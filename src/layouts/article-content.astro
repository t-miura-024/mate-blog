---
import { ArticleBody } from '@/components/article-body';
import { ArticleMeta } from '@/components/article-meta';
import { MedicalNotice } from '@/components/medical-notice';
import { PhotoFigure } from '@/components/photo-figure';
import { Toc } from '@/components/toc';
import { toTagLinks, type Article } from '@/lib/articles';
import { categoryHref, getCategoryBySlug } from '@/lib/categories';

type Props = {
  article: Article;
};

const { article } = Astro.props;
const category = getCategoryBySlug(article.categorySlug);
if (category === undefined) {
  throw new Error(`unknown category: ${article.categorySlug}`);
}
---

<article>
  <h1 class="text-display font-bold">{article.title}</h1>
  <div class="mt-4">
    <ArticleMeta
      publishedAt={article.publishedAt}
      categoryName={category.name}
      categoryHref={categoryHref(category)}
      tags={toTagLinks(article.tags)}
    />
  </div>
  {
    article.eyecatchUrl !== undefined && (
      <div class="mt-8">
        <PhotoFigure
          src={article.eyecatchUrl}
          alt={article.eyecatchAlt ?? article.title}
          aspect="video"
          loading="eager"
          fetchPriority="high"
        />
      </div>
    )
  }
  {article.tocItems.length > 0 && <Toc items={article.tocItems} className="mt-8" />}
  <ArticleBody className="mt-8">
    <Fragment set:html={article.html} />
  </ArticleBody>
  {
    article.showMedicalNotice && (
      <div class="mt-10">
        <MedicalNotice />
      </div>
    )
  }
</article>
