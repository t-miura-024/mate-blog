---
import { MICROCMS_API_KEY, MICROCMS_SERVICE_DOMAIN } from 'astro:env/server';
import { Container } from '@/components/container';
import BaseLayout from '@/layouts/base-layout.astro';
import ArticleContent from '@/layouts/article-content.astro';
import { getArticleSource } from '@/lib/microcms';

export const prerender = false;

const { id } = Astro.params;
const draftKey = Astro.url.searchParams.get('draftKey');

if (id === undefined || draftKey === null) {
  return Astro.redirect('/');
}

const source = getArticleSource({
  serviceDomain: MICROCMS_SERVICE_DOMAIN,
  apiKey: MICROCMS_API_KEY,
});

const article = await source.getDraft(id, draftKey);

if (article === undefined) {
  return new Response('記事が見つかりません', { status: 404 });
}
---

<BaseLayout title={`[プレビュー] ${article.title}`} noindex>
  <Container size="narrow" className="py-10">
    <p class="rounded-md bg-accent-soft px-4 py-3 text-small text-accent-strong">
      下書きプレビューです。このページは検索エンジンに登録されません。
    </p>
    <div class="mt-6">
      <ArticleContent article={article} />
    </div>
  </Container>
</BaseLayout>
