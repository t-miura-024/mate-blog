{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "ignorePatterns": [
    "dist/",
    "coverage/",
    "storybook-static/",
    ".astro/",
    "pnpm-lock.yaml",
    "node_modules/",
    ".wrangler/"
  ]
}
